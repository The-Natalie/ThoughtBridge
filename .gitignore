# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Base (applies to any project) ---

# os / editor
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*
!.env.example

# logs
*.log

# test / coverage output
/coverage
e2e-screenshots/

# --- Node / JavaScript (delete this block if not applicable) ---

/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# framework/host build output - adjust to your framework
/build
/dist
/.next/
/out/
next-env.d.ts
.vercel

# --- Python (delete this block if not applicable) ---

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Muse conversation logs (local, private)
/conversation-log/
