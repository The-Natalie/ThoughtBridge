# ThoughtBridge environment configuration.
# All values below are PLACEHOLDERS — replace with real values in your local `.env`.
# `.env` is gitignored and must never be committed. See PRD §9 for details.

# ThoughtBridge-dedicated Meta Model API key (PRD §9).
# Create a separate key for ThoughtBridge — do not reuse the Muse Code or Playground keys.
# First development checkpoint (PRD Phase 1) is one successful API call with this key.
MODEL_API_KEY=your-thoughtbridge-meta-api-key-here

# Anthropic API key for the independent plan/execution reviewers (default provider).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Muse Spark model ID to use for all LLM reasoning (PRD §8).
# Record the exact model ID available to the participant key at the first successful call.
META_MODEL=your-muse-spark-model-id-here

# SQLite database file location (PRD §8–§9).
# Single `.db` file holding relational tables, FTS5 index, and sqlite-vec vectors.
DATABASE_PATH=./data/thoughtbridge.db

# Local embedding model used by fastembed for indexing (PRD §8).
# BGE-small-class default (~90 MB, CPU, zero marginal cost).
EMBEDDING_MODEL=your-fastembed-model-name-here

# Maximum upload size in megabytes (PRD §9).
# Applies to .txt/.md uploads, plus .pdf/.docx when those Preferred adapters land.
MAX_UPLOAD_MB=10

# Maximum characters accepted per artifact, including pasted text (PRD §9).
MAX_ARTIFACT_CHARS=500000
